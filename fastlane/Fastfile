default_platform(:ios)

# Il numero di build sta in pubspec.yaml ("version: 1.0.0+N"). Ogni upload
# su TestFlight ne vuole uno nuovo: se dall'ultimo commit non è già salito,
# lo alza di uno.
def ensure_build_number_bumped
  path = "../pubspec.yaml"
  content = File.read(path)
  current = content[/^version:\s*[\d.]+\+(\d+)/, 1].to_i
  committed = `git -C .. show HEAD:pubspec.yaml 2>/dev/null`[/^version:\s*[\d.]+\+(\d+)/, 1].to_i
  return current if current > committed

  File.write(path, content.sub(/^(version:\s*[\d.]+\+)#{current}$/) { "#{$1}#{current + 1}" })
  UI.success "Build #{current} → #{current + 1}"
  current + 1
end

platform :ios do
  desc "Compila, firma e carica una build su TestFlight"
  lane :beta do
    build = ensure_build_number_bumped

    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_filepath: ENV.fetch("ASC_KEY_PATH"),
    )

    # Mai ricaricare un pacchetto vecchio: si parte da zero.
    sh("rm -rf ../build/ios/ipa")
    # Con config/supabase.json (non nel repo) la build ha l'online; senza,
    # il manifesto «Gioca con amici» dice che non è disponibile.
    online = File.exist?("../config/supabase.json") ? " --dart-define-from-file=config/supabase.json" : ""
    UI.important("config/supabase.json mancante: build senza online") if online.empty?
    sh("cd .. && ruby tool/ios_online_config.rb")
    # Flutter prepara il progetto (codice Dart compilato, dart-define); poi
    # archivio ed esportazione li fa xcodebuild con la chiave API di App Store
    # Connect, così i profili includono i permessi (Accedi con Apple) anche
    # senza un account in Xcode.
    auth = "-allowProvisioningUpdates " \
           "-authenticationKeyPath #{File.expand_path(ENV.fetch('ASC_KEY_PATH'), '..')} " \
           "-authenticationKeyID #{ENV.fetch('ASC_KEY_ID')} " \
           "-authenticationKeyIssuerID #{ENV.fetch('ASC_ISSUER_ID')}"
    # RANKED_DEBUG=1 bundle exec fastlane ios beta: build di prova
    # (lib/build_flags.dart): classificata sbloccata, accesso con email,
    # due persone bastano coi bot. Senza, la build è quella da negozio.
    online += " --dart-define=OBERTA_TEST=true" if ENV["RANKED_DEBUG"] == "1"
    # Flutter lancia CocoaPods: fuori dal bundle di fastlane, che non lo contiene.
    Bundler.with_unbundled_env { sh("cd .. && flutter build ios --release --config-only#{online}") }
    sh("rm -rf ../build/ios/archive/Runner.xcarchive")
    sh(
      "cd .. && xcodebuild -workspace ios/Runner.xcworkspace -scheme Runner -configuration Release " \
      "-destination generic/platform=iOS -archivePath build/ios/archive/Runner.xcarchive archive #{auth} | tail -5"
    )
    sh(
      "cd .. && xcodebuild -exportArchive -archivePath build/ios/archive/Runner.xcarchive " \
      "-exportPath build/ios/ipa -exportOptionsPlist ios/ExportOptionsLocal.plist #{auth}"
    )
    ipa = Dir["../build/ios/ipa/*.ipa"].first
    UI.user_error!("Nessun pacchetto firmato") unless ipa
    File.rename(ipa, "../build/ios/ipa/Oberta.ipa") unless ipa.end_with?("/Oberta.ipa")

    # Senza il permesso di Accedi con Apple il login non funzionerebbe: meglio
    # fermarsi che caricare una build rotta.
    sh("cd ../build/ios/ipa && rm -rf Payload && unzip -qo Oberta.ipa && " \
       "codesign -d --entitlements - --xml Payload/Runner.app | grep -q com.apple.developer.applesignin && rm -rf Payload")

    upload_to_testflight(
      ipa: "build/ios/ipa/Oberta.ipa",
      api_key: api_key,
      skip_waiting_for_build_processing: true,
    )

    UI.success "Build #{build} caricata su TestFlight"
    # La build minima NON sale da sola: si alza a mano quando la build è
    # davvero in vendita (docs/release.md):
    #   bundle exec fastlane min_build platform:ios build:#{build}
  end

  # La chiave API di App Store Connect, la stessa della lane beta.
  def asc_api_key
    app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_filepath: ENV.fetch("ASC_KEY_PATH"),
    )
  end

  desc "Carica solo testi e screenshot della scheda App Store (niente build, niente revisione)"
  lane :metadata do
    deliver(
      api_key: asc_api_key,
      metadata_path: "./fastlane/metadata",
      screenshots_path: "./fastlane/screenshots",
      skip_binary_upload: true,
      skip_metadata: false,
      skip_screenshots: false,
      overwrite_screenshots: true,
      submit_for_review: false,
      automatic_release: false,
      force: true, # niente anteprima HTML da confermare
      precheck_include_in_app_purchases: false,
    )
  end

  desc "Manda l'ultima build caricata ai tester esterni del gruppo Amici"
  lane :external_beta do
    # Il contatto per la revisione beta di Apple: nell'ambiente, non nel repo.
    beta_info = {
      contact_email: ENV.fetch("BETA_CONTACT_EMAIL", "<CONTACT_EMAIL>"),
      contact_first_name: ENV.fetch("BETA_CONTACT_FIRST_NAME", "<FIRST_NAME>"),
      contact_last_name: ENV.fetch("BETA_CONTACT_LAST_NAME", "<LAST_NAME>"),
      contact_phone: ENV.fetch("BETA_CONTACT_PHONE", "<PHONE>"),
      demo_account_required: false,
      notes: File.read("metadata/review_information/notes.txt"),
    }
    upload_to_testflight(
      api_key: asc_api_key,
      distribute_only: true, # nessun upload: si distribuisce la build più recente
      app_platform: "ios",
      distribute_external: true,
      groups: ["External Tester"],
      notify_external_testers: true,
      changelog: File.read("testflight/what_to_test_it.txt"),
      localized_build_info: {
        "it" => { whats_new: File.read("testflight/what_to_test_it.txt") },
        "en-US" => { whats_new: File.read("testflight/what_to_test_en-US.txt") },
      },
      beta_app_description: File.read("metadata/it/description.txt"),
      beta_app_feedback_email: beta_info[:contact_email],
      beta_app_review_info: beta_info,
      submit_beta_review: true,
    )
  end
end

platform :android do
  PACKAGE_NAME = "com.obertagame.oberta"
  AAB = "build/app/outputs/bundle/release/app-release.aab"

  # Il JSON del service account di Google Play (docs/release.md, sezione 7.4):
  # il percorso sta in fastlane/.env, il file resta sul Mac.
  def play_json_key
    path = ENV["PLAY_JSON_KEY"].to_s.strip
    if path.empty?
      UI.user_error!("PLAY_JSON_KEY mancante in fastlane/.env: il percorso (dalla radice del repo) del JSON " \
                     "del service account di Google Play. Come crearlo: docs/release.md, sezione 7.4.")
    end
    full = File.expand_path(path, "..")
    UI.user_error!("PLAY_JSON_KEY punta a #{path}, che non c'è: scaricalo da Google Cloud (docs/release.md, sezione 7.4).") unless File.file?(full)
    full
  end

  desc "Compila l'AAB firmato con la chiave di caricamento e lo carica come bozza sulla traccia interna di Google Play"
  lane :internal do
    json_key = play_json_key # prima di tutto: senza chiave non si compila per niente
    unless File.file?("../android/key.properties")
      UI.user_error!("android/key.properties mancante: senza la chiave di caricamento l'AAB sarebbe firmato " \
                     "con quella di debug e Play lo rifiuterebbe (docs/release.md, sezione 7.1).")
    end
    build = ensure_build_number_bumped

    sh("rm -rf ../build/app/outputs/bundle/release")
    online = File.exist?("../config/supabase.json") ? " --dart-define-from-file=config/supabase.json" : ""
    UI.important("config/supabase.json mancante: build senza online") if online.empty?
    # RANKED_DEBUG=1 bundle exec fastlane android internal: build di prova
    # (lib/build_flags.dart), solo per i tester. Senza, è quella da negozio.
    online += " --dart-define=OBERTA_TEST=true" if ENV["RANKED_DEBUG"] == "1"
    sh("cd .. && flutter build appbundle --release#{online}")
    UI.user_error!("Nessun AAB in #{AAB}") unless File.file?("../#{AAB}")

    # Mai caricare un AAB firmato con la chiave di debug.
    signer = sh("cd .. && keytool -printcert -jarfile #{AAB}", log: false)
    UI.user_error!("L'AAB è firmato con la chiave di debug") if signer.include?("CN=Android Debug")

    upload_to_play_store(
      package_name: PACKAGE_NAME,
      json_key: json_key,
      aab: AAB,
      track: "internal",
      # Finché l'app non è pubblicata Play accetta solo bozze; poi la si
      # manda ai tester da Play Console (Test interno → Modifica release).
      release_status: "draft",
      metadata_path: "./fastlane/metadata/android",
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      skip_upload_changelogs: false, # changelogs/default.txt come «Novità»
    )

    UI.success "Build #{build} caricata come bozza sulla traccia interna di Google Play"
  end

  desc "Carica solo testi e immagini della scheda Google Play (niente build)"
  lane :metadata do
    upload_to_play_store(
      package_name: PACKAGE_NAME,
      json_key: play_json_key,
      metadata_path: "./fastlane/metadata/android",
      skip_upload_apk: true,
      skip_upload_aab: true,
      skip_upload_changelogs: true,
      skip_upload_metadata: false,
      skip_upload_images: false,
      skip_upload_screenshots: false,
    )
  end
end

desc "Build minima ammessa dal server (aggiornamento obbligatorio): fastlane min_build platform:ios build:60"
lane :min_build do |options|
  platform = options[:platform].to_s
  build = options[:build].to_s
  UI.user_error!("platform: ios, android, macos, windows o linux") unless %w[ios android macos windows linux].include?(platform)
  UI.user_error!("build: un numero (il +N di pubspec)") unless build.match?(/\A\d+\z/)
  sh("cd .. && tool/release/set_min_build.sh #{platform} #{build}")
end
